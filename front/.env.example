# Source des données du front : "mock" (données simulées, par défaut) ou "http" (API).
VITE_DATA_SOURCE=mock
# Base de l'API, utilisée seulement avec VITE_DATA_SOURCE=http.
VITE_API_BASE_URL=http://localhost:8080/api
# Latence simulée des mocks, en millisecondes.
VITE_MOCK_LATENCY_MS=250
# Session simulée : pmLead (défaut, administratrice fonctionnelle), assetManager, financeManager
VITE_MOCK_SESSION=pmLead
# true : session simulée ouverte sans écran de connexion (développement, captures)
VITE_MOCK_AUTO_LOGIN=false
# Code de connexion simulé (123456) affiché à l'écran : toujours en développement sauf false ; dans un build, seulement si true
VITE_MOCK_EXPOSE_LOGIN_CODE=true
