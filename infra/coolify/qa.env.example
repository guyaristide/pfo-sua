# Variables à saisir dans Coolify (ressource « SUA · recette », onglet Environment Variables).
# Elles servent au build du front (arguments) et au démarrage des services.

# --- Phase 1 : front seul, données simulées -----------------------------------
VITE_DATA_SOURCE=mock
VITE_MOCK_LATENCY_MS=250
VITE_MOCK_SESSION=pmLead
VITE_MOCK_AUTO_LOGIN=false
# Le code de connexion simulé s'affiche à l'écran (pas de serveur d'e-mail en recette simulée).
VITE_MOCK_EXPOSE_LOGIN_CODE=true

# --- Phase 2 : API livrée ---------------------------------------------------------
# VITE_DATA_SOURCE=http
# VITE_API_BASE_URL=/api
# VITE_MOCK_EXPOSE_LOGIN_CODE=false
# COMPOSE_PROFILES=api
# API_UPSTREAM=http://api:8080
# POSTGRES_USER=sua
# POSTGRES_PASSWORD=<généré dans Coolify, jamais dans le dépôt>
